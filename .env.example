# Restored DhanSetu Supabase project (dashboard project ref: xemwpeqpnvzupvcerpdn)
NEXT_PUBLIC_SUPABASE_URL=https://xemwpeqpnvzupvcerpdn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.dhansetuhub.in
NEXT_PUBLIC_APP_URL=https://dhansetuhub.in
NEXT_PUBLIC_AUTH_CALLBACK_PATH=/auth/callback
GOOGLE_CLIENT_ID=your-better-auth-google-client-id
GOOGLE_CLIENT_SECRET=your-better-auth-google-client-secret
# Better Auth Google callback: https://dhansetuhub.in/api/auth/callback/google
GITHUB_CLIENT_ID=your-better-auth-github-client-id
GITHUB_CLIENT_SECRET=your-better-auth-github-client-secret
BETTER_AUTH_SECRET=generate-a-long-random-server-secret
BETTER_AUTH_URL=https://dhansetuhub.in
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RESEND_API_KEY=
RESEND_FROM_EMAIL=receipts@dhansetuhub.in
PAYMENT_TERMS_VERSION=2026-09-19
FOUNDER_USER_IDS=replace-with-supabase-user-uuid
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-private-founder-sheet-id
# Base64url-encoded Google service-account JSON. Store only in the server/Render secret store.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=replace-with-server-only-secret
# Preferred on Render: upload the JSON as a Secret File and point to its mounted path.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/etc/secrets/google-service-account.json
DHANSETU_STORAGE_ROOT=/mnt/dhansetu-data
DHANSETU_STORAGE_UUID=replace-with-external-ssd-uuid
RESEARCH_MAX_SOURCES=4
RESEARCH_TIMEOUT_MS=8000
